# Copy this file to ".env" and fill in your own values.
# Generate random secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- Shared secrets (must match between machines) ----------
SIGNALING_API_KEY=change-me-signaling-key   # comms API -> signaling server
COMMS_API_KEY=change-me-comms-key           # Pi -> comms API

# ---------- Signaling server (runs on the server / laptop) ----------
# The public address people will open. With ngrok, paste your ngrok https URL here.
PUBLIC_BASE_URL=http://localhost:8080
STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (needed when the Pi is on 4G / behind NAT). Leave empty for LAN tests.
TURN_URLS=
# TURN_URLS=turn:YOUR_VPS_IP:3478?transport=udp,turn:YOUR_VPS_IP:3478?transport=tcp
TURN_SECRET=                                # same value as static-auth-secret in turnserver.conf
ROOM_TTL_SECONDS=1800
MAX_VIEWERS_PER_ROOM=3

# ---------- Communications API (runs on the server / laptop) ----------
DRY_RUN=true                                # true = print alerts instead of sending
SIGNALING_INTERNAL_URL=http://localhost:8080
# Address the Pi uses to reach the signaling server (the ngrok URL in the field)
SIGNALING_URL=http://localhost:8080

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Twilio sandbox number
CALL_CENTRE_WHATSAPP=+2547XXXXXXXX          # comma-separated

AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=+2547XXXXXXXX               # your Africa's Talking voice number
CALL_CENTRE_PHONES=+2547XXXXXXXX            # comma-separated operator phones

# ---------- Raspberry Pi (tower) ----------
TOWER_ID=WT-A3
TOWER_NAME=Lokiriama road
COMMS_API_URL=http://localhost:8000
CAMERA_URLS=http://192.168.4.11:81/stream,http://192.168.4.12:81/stream
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=12
